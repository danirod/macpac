pkgname=make
pkgver=4.4.1
pkgrel=1
pkgdesc="Controls the generation of executables and other non-source files of a program from the program's source files"
arch=(arm64 x86_64)
url=""
license=('GPL3')
groups=()
depends=()
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
source=("https://ftp.gnu.org/gnu/make/make-$pkgver.tar.gz")
b2sums=("09a4ad8060259e36854b525ab610fd317a86f4926e44e3ab8adba75dccc8d4b445df9dd25ccfb4c25a54bc0e98238a9127e36401d74cbc3503a329eadcdf4995")

build() {
	cd "$pkgname-$pkgver"
	./configure --prefix=/macpac
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir/" install
}
